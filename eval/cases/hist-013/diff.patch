diff --git a/apps/kc-web/scripts/clean.mjs b/apps/kc-web/scripts/clean.mjs
new file mode 100644
index 0000000..f7c1643
--- /dev/null
+++ b/apps/kc-web/scripts/clean.mjs
@@ -0,0 +1,45 @@
+/**
+ * Räumt die Bau-Ordner ab — in Node, nicht über die Shell, und mit Nachweis.
+ *
+ * Zwei Fehler, die hier schon drinsteckten und beide still waren:
+ *
+ * 1. Vorher stand `rm -rf dist .astro …` im package.json. Das läuft in Git Bash
+ *    und bricht in PowerShell ab, weil es dort kein `rm` gibt. Wer die
+ *    Aufräumarbeit an die Shell delegiert, delegiert sie an die Shell, die
+ *    gerade zufällig läuft.
+ * 2. `rmSync(..., { force: true })` verschluckt Fehler. Auf Windows hält ein
+ *    laufender Vorschau- oder Dev-Server die Dateien in `dist/` offen, das
+ *    Löschen scheitert mit EBUSY — und das Skript meldete trotzdem Erfolg.
+ *    Ein Deploy hätte danach alte Dateien hochgeladen und behauptet, frisch
+ *    gebaut zu haben.
+ *
+ * Deshalb: mit Wiederholungen löschen und danach NACHSEHEN. Was noch da ist,
+ * wird namentlich gemeldet, und das Skript bricht ab.
+ */
+import { rmSync, existsSync } from 'node:fs';
+
+const ORDNER = ['dist', '.astro', '.turbo', 'test-results', 'playwright-report'];
+
+const geblieben = [];
+for (const o of ORDNER) {
+  try {
+    // maxRetries hilft gegen kurzzeitige Sperren; gegen einen laufenden Server
+    // hilft es nicht — dann soll es auffallen.
+    rmSync(o, { recursive: true, force: true, maxRetries: 5, retryDelay: 200 });
+  } catch (e) {
+    geblieben.push(`${o} (${e.code ?? e.message})`);
+    continue;
+  }
+  if (existsSync(o)) geblieben.push(`${o} (noch vorhanden)`);
+}
+
+if (geblieben.length) {
+  console.error(
+    `\nAufräumen fehlgeschlagen: ${geblieben.join(', ')}\n\n` +
+      'Meist hält ein laufender Server die Dateien offen — der Dev-Server auf Port 4324\n' +
+      'oder eine Vorschau auf 4325/4326. Beenden und noch einmal starten.\n',
+  );
+  process.exit(1);
+}
+
+console.log(`aufgeräumt: ${ORDNER.join(', ')}`);
diff --git a/apps/kc-web/scripts/deploy-cf.mjs b/apps/kc-web/scripts/deploy-cf.mjs
new file mode 100644
index 0000000..1312a9e
--- /dev/null
+++ b/apps/kc-web/scripts/deploy-cf.mjs
@@ -0,0 +1,146 @@
+/**
+ * Deploy nach Cloudflare Pages.
+ *
+ *   corepack pnpm --filter kc-web deploy:cf         → Vorschau (Branch "preview")
+ *   corepack pnpm --filter kc-web deploy:cf:live    → Produktion (Branch "main")
+ *
+ * Läuft auf jeder Konsole: alles, was nicht `pnpm` ist, passiert in Node. Ein
+ * `rm -rf` im package.json hat am 08.09.2026 in PowerShell schon in der ersten
+ * Zeile abgebrochen.
+ *
+ * Warum ein Skript und kein nackter wrangler-Aufruf — drei Fehlerquellen:
+ *
+ * 1. **Es wird nachgewiesen, dass dist/ sauber ist.** Astro räumt den Ordner vor
+ *    jedem Bau selbst aus. Verlässt man sich darauf, merkt man nicht, wenn es
+ *    einmal nicht klappt: ein gesperrter Ordner, ein laufender Vorschau-Server,
+ *    eine Umgebung, die Löschen stillschweigend verweigert. Wer darauf
+ *    verzichtet, lädt irgendwann ein Bild hoch, das vor drei Wochen entfernt
+ *    wurde, und sieht es nicht.
+ * 2. **Es lädt nur mit grünem Gate hoch.** Ein Deploy ohne Test ist genau das,
+ *    was diese App vermeiden soll. Mit `--skip-tests` übergehbar, dann aber
+ *    sichtbar im Protokoll.
+ * 3. **Produktion ist eine bewusste Geste.** Ohne `--live` geht es auf einen
+ *    Vorschau-Branch, der die Live-Domain nicht anfasst.
+ *
+ * Achtung beim Livegang: `noindex` steht in den Layouts auf `true`. Für die
+ * Vorschau ist das richtig — eine öffentlich erreichbare Vorschau gehört nicht
+ * in den Suchindex. Vor dem echten Cutover muss es raus, siehe BLOCKERS.md.
+ */
+import { execFileSync } from 'node:child_process';
+import { existsSync, readdirSync, rmSync } from 'node:fs';
+import { join, sep } from 'node:path';
+
+const PROJEKT = 'kc-web';
+const HOST = 'kc-web-ctt.pages.dev';
+
+const live = process.argv.includes('--live');
+const ohneTests = process.argv.includes('--skip-tests');
+const branch = live ? 'main' : 'preview';
+
+const lauf = (cmd, args) => {
+  console.log(`\n→ ${cmd} ${args.join(' ')}`);
+  execFileSync(cmd, args, { stdio: 'inherit', shell: process.platform === 'win32' });
+};
+
+/** Alle Dateien unterhalb eines Ordners, rekursiv. */
+const alleDateien = (dir, gesammelt = []) => {
+  for (const e of readdirSync(dir, { withFileTypes: true })) {
+    const p = join(dir, e.name);
+    if (e.isDirectory()) alleDateien(p, gesammelt);
+    else gesammelt.push(p);
+  }
+  return gesammelt;
+};
+
+const relativ = (wurzel, p) => p.slice(wurzel.length + 1).split(sep).join('/');
+
+console.log(`Ziel: ${PROJEKT} · Branch "${branch}"${live ? ' · PRODUKTION' : ''}`);
+
+// Aufräumen ist ein Versuch, kein Versprechen — Astro räumt ohnehin selbst aus,
+// und ob es geklappt hat, entscheidet die Prüfung nach dem Bau.
+try {
+  rmSync('dist', { recursive: true, force: true, maxRetries: 5, retryDelay: 200 });
+} catch (e) {
+  console.warn(`  (dist/ liess sich nicht vorab entfernen: ${e.code ?? e.message})`);
+}
+
+lauf('corepack', ['pnpm', 'run', 'build']);
+
+if (!existsSync('dist/index.html')) {
+  console.error('\ndist/index.html fehlt — der Bau ist nicht durchgelaufen.');
+  process.exit(1);
+}
+
+/*
+ * Der Nachweis läuft über die HERKUNFT, nicht über Zeitstempel: Astro kopiert
+ * public/ mit dem ursprünglichen Datum, diese Dateien sind also legitim älter
+ * als der Bau. Ein erster Anlauf über mtime hat genau sie fälschlich gemeldet.
+ *
+ * Was in dist/ hingehört: alles unter _astro/ (von Astro erzeugt), jede
+ * index.html einer Route, und jede Datei, die es auch in public/ gibt. Alles
+ * andere ist der Rest eines früheren Baus.
+ */
+const ausPublic = new Set(
+  existsSync('public') ? alleDateien('public').map((f) => relativ('public', f)) : [],
+);
+
+const fremde = () =>
+  alleDateien('dist')
+    .map((f) => relativ('dist', f))
+    .filter((r) => !r.startsWith('_astro/') && !r.endsWith('index.html') && !ausPublic.has(r));
+
+// Reste werden ENTFERNT, nicht beklagt. dist/ ist ein Wegwerf-Ordner; eine
+// Datei daraus zu löschen kostet nichts und ist immer richtig. Abbrechen wäre
+// hier die falsche Strenge — der Lauf soll durchgehen, nur eben ohne den Rest.
+const reste = fremde();
+for (const r of reste) {
+  console.log(`  entferne Rest aus früherem Bau: dist/${r}`);
+  try {
+    rmSync(join('dist', r.split('/').join(sep)), { force: true, maxRetries: 5, retryDelay: 200 });
+  } catch (e) {
+    console.warn(`    (ging nicht: ${e.code ?? e.message})`);
+  }
+}
+
+const hartnaeckig = fremde();
+if (hartnaeckig.length) {
+  console.error(
+    [
+      '',
+      `${hartnaeckig.length} Datei(en) liessen sich nicht aus dist/ entfernen:`,
+      hartnaeckig.map((f) => `  dist/${f}`).join('\n'),
+      '',
+      'Meist hält ein laufender Server den Ordner offen — Dev auf 4324, Vorschau',
+      'auf 4325 oder 4326. Beenden, dann erneut. Hochgeladen wird so nicht.',
+      '',
+    ].join('\n'),
+  );
+  process.exit(1);
+}
+
+console.log(
+  `\n✓ dist/ ist sauber: ${alleDateien('dist').length} Dateien` +
+    (reste.length ? `, ${reste.length} Rest(e) entfernt.` : ', keine Reste.'),
+);
+
+if (ohneTests) {
+  console.warn('\n⚠ Tests übersprungen (--skip-tests). Das ist die Ausnahme, nicht der Weg.');
+} else {
+  lauf('corepack', ['pnpm', 'run', 'test']);
+}
+
+lauf('corepack', [
+  'pnpm',
+  'exec',
+  'wrangler',
+  'pages',
+  'deploy',
+  'dist',
+  '--project-name',
+  PROJEKT,
+  '--branch',
+  branch,
+  '--commit-dirty=true',
+]);
+
+console.log(`\nFertig: https://${live ? '' : branch + '.'}${HOST}`);
