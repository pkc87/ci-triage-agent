+import { test, expect } from '@playwright/test';
+
+// Saving the cart should tell the shopper that something is happening.
+test('saving the cart shows the in-flight status', async ({ page }) => {
+  await page.goto('/');
+  await page.getByTestId('add-p1').click();
+
+  await page.getByTestId('save-cart').click();
+  expect(await page.getByTestId('cart-sync-status').textContent()).toBe('Saving...');
+});
