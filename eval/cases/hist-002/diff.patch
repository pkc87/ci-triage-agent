+import { defineConfig } from 'astro/config';
+
+// Firmenwebsite Kornmüller Consulting — statischer Output, Cloudflare Pages
+// (kein Adapter, kein SSR). Kein Tracking, keine Cookies, keine Fremd-CDNs:
+// Schriften liegen selbst gehostet in node_modules/@fontsource und werden
+// mitgebaut. Deshalb braucht die Seite kein Consent-Banner.
+export default defineConfig({
+  output: 'static',
+  trailingSlash: 'ignore',
+  site: 'https://kornmueller-consulting.de',
+  build: { format: 'directory' },
+  devToolbar: { enabled: false },
+});
