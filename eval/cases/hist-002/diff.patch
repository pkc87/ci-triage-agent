@@ -0,0 +1,46 @@
+/**
+ * Zwei Projekte:
+ *   quality  — harte Zusicherungen, die jeder Commit halten muss
+ *              (Bilder sichtbar, keine Konsolenfehler, kein Querlauf, Gewicht).
+ *   visual   — Baseline-Screenshots, erst ab Phase 04 sinnvoll.
+ *
+ * Iteration:  corepack pnpm --filter kc-web test
+ * Alles:      corepack pnpm --filter kc-web test:e2e
+ * Baselines:  corepack pnpm --filter kc-web test:visual:update
+ */
+import { defineConfig } from '@playwright/test';
+
+export default defineConfig({
+  testDir: './tests',
+  fullyParallel: false,
+  forbidOnly: !!process.env.CI,
+  retries: 0,
+  reporter: process.env.CI ? 'github' : 'list',
+  use: {
+    baseURL: 'http://127.0.0.1:4325',
+    trace: 'retain-on-failure',
+  },
+  expect: {
+    toHaveScreenshot: { maxDiffPixelRatio: 0.02, animations: 'disabled' },
+  },
+  projects: [
+    { name: 'quality', testDir: './tests/quality' },
+    { name: 'visual', testDir: './tests/visual' },
+  ],
+  webServer: {
+    command:
+      'corepack pnpm exec astro build && corepack pnpm exec astro preview --host 127.0.0.1 --port 4325',
+    url: 'http://127.0.0.1:4325/',
+    /**
+     * Bewusst NICHT wiederverwenden. Ein noch laufender Vorschau-Server liefert
+     * ein altes dist/, und weil ein Teil der Prüfungen den gebauten HTML-Text
+     * liest, meldet das Gate dann Fehler, die es nicht gibt — oder schlimmer:
+     * es meldet keine, die es gibt. Am 07.09.2026 genau so passiert.
+     * Lieber ein lauter Portkonflikt als ein stilles Falschergebnis.
+     */
+    reuseExistingServer: false,
+    timeout: 120_000,
+    stdout: 'pipe',
+    stderr: 'pipe',
+  },
+});
