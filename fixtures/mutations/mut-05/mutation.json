      "suchen": "      <button type=\"button\" data-testid=\"add-${product.id}\">Add to cart</button>",
      "ersetzen": "      <button type=\"button\" data-testid=\"add-${product.id}\">Add to bag</button>"
    },
    {
      "datei": "shop/index.html",
      "suchen": "      <button type=\"button\" data-testid=\"load-reviews\">Load reviews</button>",
      "ersetzen": "      <button type=\"button\" data-testid=\"load-reviews\">Show reviews</button>"
    }
  ]
